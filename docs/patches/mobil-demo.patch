new file mode 100644
index 0000000..02c51fa
--- /dev/null
+++ b/apps/mobile/__tests__/demo-seed.test.ts
@@ -0,0 +1,73 @@
+/**
+ * Demo seed (npm run demo): ilovaning o'z kodi bilan yoziladi va asosiy raqamlar to'g'ri chiqadi.
+ * Haqiqiy SQLite (node:sqlite).
+ */
+import { randomUUID } from 'node:crypto';
+import { beforeEach, describe, expect, it } from 'vitest';
+import { DEMO_PRODUCTS } from '../../../scripts/demo-seed/data';
+import { createCatalog } from '../src/data/catalog';
+import { createLedger } from '../src/data/ledger';
+import { createPurchasing } from '../src/data/purchasing';
+import { migrate } from '../src/data/schema';
+import { seedDemo } from '../src/demo/seedDemo';
+import { openMemoryDb } from './node-sqlite';
+
+const deps = { newId: () => randomUUID(), now: () => '2026-11-04T08:00:00.000Z' };
+let db: ReturnType<typeof openMemoryDb>;
+
+beforeEach(async () => {
+  db = openMemoryDb();
+  await migrate(db);
+});
+
+describe('seedDemo', () => {
+  it('kirim 1 450 000 / berildi 1 000 000 / ostatka 450 000, savdo 385 000, bir martalik savdo qarz yaratmaydi', async () => {
+    const r = await seedDemo(db, deps);
+    expect(r.seeded).toBe(true);
+    expect(r.saleTotal).toBe(385_000n);
+    expect(r.purchaseTotal).toBe(1_450_000n);
+
+    const purchasing = createPurchasing(db, deps);
+    const suppliers = await purchasing.listSuppliers();
+    expect(suppliers).toHaveLength(1);
+    expect(suppliers[0].goods).toBe(1_450_000n);
+    expect(suppliers[0].paid).toBe(1_000_000n);
+    expect(suppliers[0].outstanding).toBe(450_000n);
+
+    const ledger = createLedger(db, deps);
+    const customers = await ledger.listCustomers();
+    const karim = customers.find((c) => c.name.startsWith('Karim'));
+    expect(karim?.balance).toBe(385_000n);
+    // bir martalik mijoz ro'yxatda ko'rinmaydi va qarzi yo'q
+    const walkin = await ledger.getWalkinSummary();
+    expect(walkin?.saleCount).toBe(1);
+    // to'liq naqd to'langan: to'lovlar summasi savdo jamiga teng (qarz yo'q)
+    const paid = db.raw.prepare('SELECT CAST(COALESCE(SUM(amount), 0) AS TEXT) AS s FROM payments WHERE customer_id = ?').get(walkin?.id ?? '') as { s: string };
+    expect(BigInt(paid.s)).toBe(70_500n);
+    expect(walkin?.balance).toBe(70_500n);
+  });
+
+  it('katalog 9 ta tovar, qoldiq: kirim va savdo hisobga olingan, manfiy qoldiq yo\'q', async () => {
+    await seedDemo(db, deps);
+    const catalog = createCatalog(db, deps);
+    const products = await catalog.listProducts();
+    expect(products).toHaveLength(DEMO_PRODUCTS.length);
+    expect(products.length).toBeGreaterThanOrEqual(8);
+    expect(products.length).toBeLessThanOrEqual(10);
+    const stock = await createPurchasing(db, deps).listStock();
+    const byName = new Map(stock.map((s) => [s.name, s.qtyMilli]));
+    expect(byName.get('Guruch')).toBe(90_000n); // 100 - 10
+    expect(byName.get('Shakar')).toBe(45_000n); // 50 - 5
+    expect(byName.get('Makaron')).toBe(60_000n); // 80 - 20
+    for (const q of byName.values()) expect(q >= 0n).toBe(true);
+  });
+
+  it('ikkinchi chaqiruv hech narsa qo\'shmaydi (bo\'sh bazaga yoziladi, ma\'lumot borga tegmaydi)', async () => {
+    await seedDemo(db, deps);
+    const before = db.raw.prepare('SELECT COUNT(*) AS n FROM sales').get() as { n: number };
+    const r = await seedDemo(db, deps);
+    expect(r.seeded).toBe(false);
+    const after = db.raw.prepare('SELECT COUNT(*) AS n FROM sales').get() as { n: number };
+    expect(after.n).toBe(before.n);
+  });
+});
