diff --git a/apps/mobile/src/demo/seedDemo.ts b/apps/mobile/src/demo/seedDemo.ts
new file mode 100644
index 0000000..6464230
--- /dev/null
+++ b/apps/mobile/src/demo/seedDemo.ts
@@ -0,0 +1,109 @@
+/**
+ * Demo rejimi (npm run demo): bo'sh bazaga SOXTA ma'lumotni ilovaning O'Z kodi bilan yozadi.
+ * Savdo/kirim `ledger.postSale` / `purchasing.postPurchase` orqali o'tadi: ikki mustaqil hisob (core + SQLite)
+ * ishlaydi va mos kelmasa seed to'xtaydi. Bu fayl hech qanday yig'indi hisoblamaydi.
+ *
+ * Faqat EXPO_PUBLIC_DEMO=1 bo'lganda chaqiriladi (AppRoot). Mavjud ma'lumotli bazaga tegmaydi.
+ */
+import {
+  DEMO_CUSTOMERS,
+  DEMO_PRODUCTS,
+  DEMO_PURCHASE,
+  DEMO_SALE,
+  DEMO_SHOP_NAME,
+  DEMO_SUPPLIER,
+  DEMO_WALKIN_SALE,
+} from '../../../../scripts/demo-seed/data';
+import type { SqlDb } from '../data/db';
+import { createCatalog } from '../data/catalog';
+import { createLedger } from '../data/ledger';
+import { createPurchasing } from '../data/purchasing';
+
+export interface DemoSeedResult {
+  seeded: boolean;
+  saleTotal?: bigint;
+  purchaseTotal?: bigint;
+  walkinTotal?: bigint;
+}
+
+const milli = (qty: number) => BigInt(qty) * 1000n;
+
+export async function seedDemo(db: SqlDb, deps: { newId: () => string; now: () => string }): Promise<DemoSeedResult> {
+  const existing = await db.get<{ n: number }>('SELECT (SELECT COUNT(*) FROM products) + (SELECT COUNT(*) FROM sales) + (SELECT COUNT(*) FROM customers WHERE kind = ?) AS n', ['regular']);
+  if ((existing?.n ?? 0) > 0) return { seeded: false };
+
+  const catalog = createCatalog(db, deps);
+  const ledger = createLedger(db, deps);
+  const purchasing = createPurchasing(db, deps);
+
+  await catalog.saveSettings({ shop_name: DEMO_SHOP_NAME });
+
+  const productId = new Map<string, string>();
+  for (const p of DEMO_PRODUCTS) {
+    productId.set(p.key, await catalog.saveProduct({ name: p.name, unit: p.unit, unitPrice: BigInt(p.salePrice) }));
+  }
+  const pid = (key: string) => {
+    const id = productId.get(key);
+    if (!id) throw new Error(`demo: tovar topilmadi: ${key}`);
+    return id;
+  };
+
+  const customerId = new Map<string, string>();
+  for (const c of DEMO_CUSTOMERS) customerId.set(c.key, await ledger.createCustomer({ name: c.name }));
+
+  const supplierId = await purchasing.saveSupplier({ name: DEMO_SUPPLIER.name });
+
+  for (const p of DEMO_PRODUCTS) {
+    if (p.openingStock > 0) {
+      await purchasing.adjustStock({ productId: pid(p.key), qtyMilli: milli(p.openingStock), reason: "Boshlang'ich qoldiq (demo)", clientOpId: `demo-open-${p.key}` });
+    }
+  }
+
+  const purchase = await purchasing.postPurchase({
+    clientOpId: 'demo-purchase-1',
+    supplierId,
+    lines: DEMO_PURCHASE.lines.map((l) => ({ productId: pid(l.product), qtyMilli: milli(l.qty), unitCost: BigInt(l.unitCost) })),
+    paid: { method: DEMO_PURCHASE.paid.method, amount: BigInt(DEMO_PURCHASE.paid.amount) },
+  });
+
+  // Tan narx kirimdan keyin katalogda (oxirgi kirim narxi); savdo qatoriga snapshot sifatida yoziladi
+  const catalogNow = new Map((await catalog.listProducts()).map((p) => [p.id, p]));
+  const saleLine = (key: string, qty: number) => {
+    const meta = DEMO_PRODUCTS.find((p) => p.key === key);
+    const prod = catalogNow.get(pid(key));
+    if (!meta || !prod) throw new Error(`demo: tovar topilmadi: ${key}`);
+    return {
+      productName: prod.name,
+      qtyMilli: milli(qty),
+      unit: meta.unit,
+      unitPrice: prod.unitPrice,
+      rawText: null,
+      productId: prod.id,
+      unitCost: prod.costPrice,
+    };
+  };
+
+  const cust = customerId.get(DEMO_SALE.customer);
+  if (!cust) throw new Error('demo: mijoz topilmadi');
+  const sale = await ledger.postSale({
+    clientOpId: 'demo-sale-1',
+    customerId: cust,
+    rawInput: null,
+    lines: DEMO_SALE.lines.map((l) => saleLine(l.product, l.qty)),
+  });
+
+  const walkin = await ledger.ensureWalkinCustomer();
+  const lines = DEMO_WALKIN_SALE.lines.map((l) => saleLine(l.product, l.qty));
+  const walkinTotalExpected = BigInt(DEMO_WALKIN_SALE.expectedTotal);
+  const walkinSale = await ledger.postSale({
+    clientOpId: 'demo-sale-walkin-1',
+    customerId: walkin,
+    rawInput: null,
+    lines,
+    paid: { method: DEMO_WALKIN_SALE.method, amount: walkinTotalExpected },
+  });
+
+  if (sale.total !== BigInt(DEMO_SALE.expectedTotal)) throw new Error(`demo: savdo jami kutilganidan farq qildi: ${sale.total}`);
+  if (purchase.total !== BigInt(DEMO_PURCHASE.expectedTotal)) throw new Error(`demo: kirim jami kutilganidan farq qildi: ${purchase.total}`);
+  return { seeded: true, saleTotal: sale.total, purchaseTotal: purchase.total, walkinTotal: walkinSale.total };
+}
