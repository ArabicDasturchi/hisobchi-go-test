# Hisobchi Go — Environment Variables (faqat namuna qiymatlar)
# Nusxa oling: .env — haqiqiy kalitlar Git'ga tushmaydi (.gitignore).
#
# Mobil ilova o'z sozlamasini apps/mobile/.env dan oladi.
# Faqat public anon kalit mobil ilovaga beriladi.

# Supabase (server tomoni / CLI uchun)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY

# Service-role: FAQAT server/CLI. Mobil ilovaga yoki EXPO_PUBLIC_* ga yozilmaydi.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY-SERVER-ONLY

# AI parsing (server-side only)
AI_API_KEY=
AI_MODEL=

# AI provider (yangi main konfiguratsiyasi)
ANTHROPIC_API_KEY=

# Ovoz -> matn (STT)
STT_PROVIDER=
STT_API_KEY=

# App
APP_ENV=development
