# Hisobchi Go mobil ilova — bulut (ixtiyoriy).
# Nusxa oling: .env  (git'ga tushmaydi). Bo'sh qoldirilsa, ilova lokal rejimda to'liq ishlaydi.
# FAQAT public "anon" kalit. Service-role kalitini bu yerga HECH QACHON yozmang — u ilova ichiga joylanadi.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
