# Nusxa oling: cp .env.example .env  (.env gitga qo'shilmaydi). Qiymatlarni bu yerga YOZMANG.
# Barchasi hosting (Vercel Project Settings > Environment Variables) da ham shu nomlar bilan kiritiladi.

# Supabase loyiha URL (masalan https://<ref>.supabase.co). Joriy loyiha: docs/QARORLAR.md
SUPABASE_URL=
# Publishable (anon) kalit: ommaviy kalit. service_role / sb_secret_* KIRITILMAYDI, server rad etadi.
SUPABASE_PUBLISHABLE_KEY=
# MCP serverning ommaviy manzili (origin), masalan https://hisobchi-mcp.vercel.app
MCP_PUBLIC_URL=

# Ixtiyoriy: ruxsat etilgan OAuth client_id'lar (vergul bilan). DCR o'chirilgandan keyin qo'shish tavsiya etiladi.
MCP_ALLOWED_CLIENT_IDS=
# FAQAT lokal dev: oddiy sessiya tokeniga (client_id yo'q) ruxsat. Productionda server ishga tushmaydi.
MCP_ALLOW_FIRST_PARTY_TOKEN=
