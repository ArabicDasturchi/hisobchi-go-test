# Admin panel — Vercel loyihasi `hisobchi-go-admin` (Root Directory: apps/admin). Bu fayl faqat namuna.
# Haqiqiy qiymatlar .env.local da (git'ga tushmaydi) yoki Vercel Environment Variables da.
# Public (anon/publishable) kalit. service_role kaliti hech qachon bu yerga yozilmaydi.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
